# App (public, bundled into the app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The publishable (anon) key. Never put a secret key in the app.
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.com.example.marketplace
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# Native build config (read by app.config.ts)
META_APP_ID=
META_CLIENT_TOKEN=
