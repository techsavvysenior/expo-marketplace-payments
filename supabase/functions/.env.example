# Edge Function secrets. Set with: supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
APP_SCHEME=marketplace
BRAND_NAME=Marketplace
REVENUECAT_WEBHOOK_SECRET=
# Used only if REVENUECAT_WEBHOOK_SECRET is empty
REVENUECAT_AUTH_HEADER=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
# From Events Manager, Test events. Remove in production.
META_TEST_EVENT_CODE=
